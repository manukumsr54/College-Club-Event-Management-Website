# Frontend Environment Configuration (.env.example)
# Do NOT put production secrets here.

# Production API Base URL
# Option A (Unified Vercel Deployment):
# Leave empty or set to /api so requests stay on the same domain (recommended)
# VITE_API_URL=/api

# Option B (Separate Frontend & Backend Vercel Projects):
# Set this to your deployed backend Vercel URL
# VITE_API_URL=https://your-backend-api.vercel.app/api

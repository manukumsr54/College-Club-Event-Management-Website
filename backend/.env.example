# Backend Environment Configuration (.env.example)
# Copy to .env for local development. In Vercel, set these in Project Settings -> Environment Variables.
# NEVER commit real passwords, secrets, or actual database credentials.

PORT=5000
NODE_ENV=production

# Client URL for CORS (comma-separated if multiple, e.g. https://your-site.vercel.app)
CLIENT_URL=http://localhost:5173

# Hosted PostgreSQL Database URL (e.g. Neon, Supabase, Render, AWS RDS)
# Format: postgresql://[user]:[password]@[host]/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:your_neon_password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Individual DB fields (used only if DATABASE_URL is not set)
DB_USER=postgres
DB_PASSWORD=your_local_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=college_club_events

# Connection pool settings for serverless environments
DB_POOL_MAX=10

# JWT Authentication Secret (Generate a strong random 32+ character key for production)
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

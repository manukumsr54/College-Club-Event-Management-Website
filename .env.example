# College Club Event Management - Root Environment Variables (.env.example)
# DO NOT commit real secrets or production credentials.
# In Vercel, set these in Project Settings -> Environment Variables.

# ----------------------------------------------------
# 1. Backend / Database Variables (Vercel Serverless Function)
# ----------------------------------------------------
NODE_ENV=production
PORT=5000

# Hosted PostgreSQL Database URL (Neon / Supabase / AWS RDS)
# Neon connection string format (ensure ?sslmode=require is included):
DATABASE_URL=postgresql://neondb_owner:your_neon_password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT Secret (Mandatory in production: use a strong, secure random key)
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Optional CORS allowed origin(s), comma-separated
CLIENT_URL=http://localhost:5173

# Optional DB Pool size limit for serverless functions (default: 10)
DB_POOL_MAX=10

# ----------------------------------------------------
# 2. Frontend Variables (Vite Client)
# ----------------------------------------------------
# Unified Vercel deployment (recommended): leave as /api or empty
# Separate frontend deployment: set to https://your-backend-api.vercel.app/api
VITE_API_URL=/api
